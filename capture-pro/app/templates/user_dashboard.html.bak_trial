{% extends "base_modern.html" %}
{% set active = "my" %}
{% block title %}My Dashboard - AndikaToolsV1{% endblock %}
{% block content %}
<div style="max-width:900px;margin:0 auto;padding:20px">

  <div class="topbar">
    <div class="topbar-title">
      <h1>👤 My Dashboard</h1>
      <p>Halo, {{ user.name or user.email }}</p>
    </div>
    <div class="topbar-actions">
      <a href="/logout-user" class="btn btn-red">Logout</a>
    </div>
  </div>

  <!-- Status Card -->
  <div style="background:var(--bg-glass);backdrop-filter:blur(20px);border:1px solid var(--border-subtle);border-radius:16px;padding:24px;margin-bottom:20px">
    <h2 style="margin:0 0 16px;font-size:18px;color:var(--accent-primary)">📊 Status Akun</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px">
      <div style="text-align:center;padding:14px;background:var(--bg-secondary);border-radius:10px">
        <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase">Plan</div>
        <div style="font-size:20px;font-weight:700;color:var(--accent-primary);margin-top:4px">{{ user.plan|upper }}</div>
      </div>
      <div style="text-align:center;padding:14px;background:var(--bg-secondary);border-radius:10px">
        <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase">Status</div>
        <div style="font-size:20px;font-weight:700;color:{% if user.is_active() %}var(--accent-green){% else %}var(--accent-red){% endif %};margin-top:4px">
          {{ 'AKTIF' if user.is_active() else 'EXPIRED' }}
        </div>
      </div>
      <div style="text-align:center;padding:14px;background:var(--bg-secondary);border-radius:10px">
        <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase">Sisa Hari</div>
        <div style="font-size:20px;font-weight:700;color:var(--accent-yellow);margin-top:4px">{{ user.days_left() }}</div>
      </div>
      <div style="text-align:center;padding:14px;background:var(--bg-secondary);border-radius:10px">
        <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase">Sesi</div>
        <div style="font-size:20px;font-weight:700;color:var(--accent-cyan);margin-top:4px">{{ user.api_used }}/{{ user.api_quota }}</div>
      </div>
    </div>
  </div>

  <!-- License Key -->
  {% if license_key %}
  <div style="background:var(--bg-glass);backdrop-filter:blur(20px);border:1px solid var(--border-subtle);border-radius:16px;padding:24px;margin-bottom:20px">
    <h2 style="margin:0 0 16px;font-size:18px;color:var(--accent-primary)">🔑 License Key Kamu</h2>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 12px">Copy key ini dan masukkan ke script untuk aktivasi.</p>
    <div id="licenseKey" onclick="copyKey(this)" style="background:var(--bg-primary);padding:14px;border-radius:8px;font-family:monospace;font-size:12px;color:var(--accent-primary);word-break:break-all;border:1px solid var(--border-subtle);cursor:pointer">{{ license_key }}</div>
    <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
      <button onclick="copyKey(document.getElementById('licenseKey'))" style="padding:10px 18px;background:var(--gradient-primary);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600">📋 Copy Key</button>
      <a href="/capture" target="_blank" style="padding:10px 18px;background:var(--accent-green);color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600">🎯 Buka Capture</a>
      <a href="/templates" style="padding:10px 18px;background:var(--bg-tertiary);color:var(--text-primary);border-radius:8px;text-decoration:none;font-size:13px;font-weight:600">📚 Templates</a>
    </div>
  </div>
  {% endif %}

  <!-- Upgrade Info -->
  {% if user.plan == 'trial' %}
  <div style="background:linear-gradient(135deg,rgba(99,102,241,0.1),rgba(168,85,247,0.1));border:1px solid var(--accent-primary);border-radius:16px;padding:24px;margin-bottom:20px">
    <h2 style="margin:0 0 12px;font-size:18px;color:var(--accent-primary)">🚀 Upgrade ke Pro</h2>
    <p style="font-size:13px;color:var(--text-secondary);margin:0 0 16px">Kamu masih di trial. Upgrade untuk akses semua fitur:</p>
    <ul style="font-size:13px;color:var(--text-secondary);line-height:1.8;margin:0 0 16px 20px;padding:0">
      <li>2.000 sesi/bulan</li>
      <li>Multi-tunnel (3 aktif)</li>
      <li>Semua template + custom</li>
      <li>OSINT toolkit lengkap</li>
      <li>Priority support</li>
    </ul>
    <a href="#" style="display:inline-block;padding:12px 24px;background:var(--gradient-primary);color:#fff;border-radius:10px;text-decoration:none;font-size:14px;font-weight:700">💳 Upgrade - Rp 299rb/bulan</a>
    <p style="font-size:11px;color:var(--text-muted);margin:12px 0 0">Hubungi admin via Telegram untuk aktivasi.</p>
  </div>
  {% endif %}

  <!-- Subscription History -->
  {% if subscriptions %}
  <div style="background:var(--bg-glass);backdrop-filter:blur(20px);border:1px solid var(--border-subtle);border-radius:16px;padding:24px">
    <h2 style="margin:0 0 16px;font-size:18px;color:var(--accent-primary)">📋 Riwayat Subscription</h2>
    {% for s in subscriptions %}
    <div style="padding:12px;background:var(--bg-secondary);border-radius:8px;margin-bottom:8px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div>
        <div style="font-weight:700">{{ s.plan|upper }}</div>
        <div style="font-size:11px;color:var(--text-muted)">{{ s.created_at[:10] if s.created_at else '-' }}</div>
      </div>
      <div style="text-align:right">
        <div style="font-weight:700;color:var(--accent-green)">Rp {{ "{:,}".format(s.amount or 0) }}</div>
        <div style="font-size:11px;color:var(--text-muted)">{{ s.status }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>

<script>
function copyKey(el) {
  const text = el.textContent.trim();
  navigator.clipboard.writeText(text);
  alert("✅ License key dicopy!");
}
</script>
{% endblock %}
